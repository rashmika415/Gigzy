{
  "expo": {
    "name": "LocalWorks",
    "slug": "LocalWorks",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "localworks",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.isuru.localworks",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow LocalWorks to select a profile photo or business logo.",
          "cameraPermission": "Allow LocalWorks to take a profile photo or business logo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#087F73",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F8F8"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow LocalWorks to find nearby gigs and set gig locations."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow LocalWorks to add scheduled gigs to your calendar."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9bf889a9-7379-448d-a569-12835be1dddc"
      }
    }
  }
}
