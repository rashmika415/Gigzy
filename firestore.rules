rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(userId) { return signedIn() && request.auth.uid == userId; }
    function currentUser() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isAdmin() { return signedIn() && currentUser().data.role == 'admin'; }
    function active() { return signedIn() && currentUser().data.suspended != true; }
    function validRole() { return request.resource.data.role in ['freelancer', 'client']; }
    function protectedUserFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'role', 'isVerified', 'suspended', 'suspensionReason',
        'ratingAverage', 'ratingCount', 'skillBadges'
      ]);
    }
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if owns(userId) && validRole()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.suspended != true && request.resource.data.isVerified != true;
      allow update: if isAdmin() || (owns(userId) && active() && protectedUserFieldsUnchanged());
      allow delete: if false;
      match /notifications/{notificationId} {
        allow read: if owns(userId);
        allow create, delete: if isAdmin();
        allow update: if owns(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      }
      match /reviews/{reviewId} {
        allow read: if signedIn();
        allow create: if active() && request.auth.uid != userId
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.rating is number
          && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
          && request.resource.data.comment is string && request.resource.data.comment.size() <= 1000;
        allow update, delete: if active() && resource.data.authorId == request.auth.uid;
      }
      match /endorsements/{endorsementId} {
        allow read: if signedIn();
        allow create: if active() && request.auth.uid != userId
          && request.resource.data.endorserId == request.auth.uid;
        allow update: if false;
        allow delete: if isAdmin() || (active() && resource.data.endorserId == request.auth.uid);
      }
      match /pushTokens/{tokenId} {
        allow read, create, update, delete: if owns(userId) && active();
      }
    }
    match /gigs/{gigId} {
      allow read: if signedIn();
      allow create: if active() && request.resource.data.postedBy.uid == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() >= 5
        && request.resource.data.description is string && request.resource.data.description.size() >= 20
        && request.resource.data.pay is number && request.resource.data.pay > 0
        && request.resource.data.status == 'open';
      allow update: if active() && (resource.data.postedBy.uid == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['applicantsCount']));
      allow delete: if active() && resource.data.postedBy.uid == request.auth.uid;
    }
    match /chats/{chatId} {
      allow read, update, delete: if active() && request.auth.uid in resource.data.participants;
      allow create: if active() && request.auth.uid in request.resource.data.participants;
      match /messages/{messageId} {
        allow read: if active() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if active() && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow update, delete: if active() && resource.data.senderId == request.auth.uid;
      }
    }
  }
}
