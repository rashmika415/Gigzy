rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(userId) { return signedIn() && request.auth.uid == userId; }
    function currentUser() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isAdmin() { return signedIn() && currentUser().data.role == 'admin' && currentUser().data.get('suspended', false) != true; }
    function active() {
      return signedIn() &&
        (!exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || currentUser().data.get('suspended', false) != true);
    }
    function validRole() { return request.resource.data.role in ['freelancer', 'client']; }
    function validProfilePhoto() {
      let photo = request.resource.data.get('photoURL', '');
      return photo is string && photo.size() <= 100000
        && (photo == '' || photo.matches('https://.*')
          || photo.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+'));
    }
    function protectedUserFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'role', 'isVerified', 'suspended', 'suspensionReason',
        'suspensionType', 'suspendedUntil', 'warningCount',
        'lastWarningReason', 'lastWarnedAt',
        'ratingAverage', 'ratingCount', 'skillBadges'
      ]);
    }
    match /announcements/{announcementId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'title', 'body', 'audience', 'targetUserId', 'status',
          'deliveredCount', 'createdBy', 'createdAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 80
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 5 && request.resource.data.body.size() <= 500
        && request.resource.data.audience in ['all', 'freelancer', 'client', 'user']
        && ((request.resource.data.audience == 'user'
            && request.resource.data.targetUserId is string
            && request.resource.data.targetUserId.size() > 0)
          || (request.resource.data.audience != 'user'
            && !request.resource.data.keys().hasAny(['targetUserId'])))
        && request.resource.data.status == 'queued'
        && request.resource.data.deliveredCount == 0
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      // On the Spark plan the authenticated admin client performs bounded
      // delivery batches. Content and audience stay immutable after creation.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'deliveredCount', 'lastUserId', 'startedAt',
          'completedAt', 'failedAt', 'errorMessage'
        ])
        && request.resource.data.status in ['processing', 'sent', 'failed']
        && request.resource.data.deliveredCount is int
        && request.resource.data.deliveredCount >= resource.data.deliveredCount
        && request.resource.data.get('errorMessage', '') is string
        && request.resource.data.get('errorMessage', '').size() <= 500;
      allow delete: if false;
    }
    function validReferralCodeUpdate(userId) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['referralCode'])
        || (!resource.data.keys().hasAny(['referralCode'])
          && request.resource.data.referralCode is string
          && request.resource.data.referralCode.matches('[A-Z0-9]{10}')
          && getAfter(/databases/$(database)/documents/referralCodes/$(request.resource.data.referralCode)).data.ownerId == userId);
    }
    match /users/{userId} {
      function verificationSubmission() {
        let requestDoc = getAfter(/databases/$(database)/documents/businessVerificationRequests/$(userId)).data;
        return owns(userId) && active() && resource.data.role == 'client'
          && resource.data.get('verificationStatus', '') in ['', 'REJECTED']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verificationStatus', 'updatedAt'])
          && request.resource.data.verificationStatus == 'PENDING'
          && request.resource.data.updatedAt == request.time
          && requestDoc.status == 'PENDING' && requestDoc.businessId == userId
          && requestDoc.submittedAt == request.time;
      }
      function verificationDecision() {
        let decision = getAfter(/databases/$(database)/documents/businessVerificationRequests/$(userId)).data;
        return isAdmin() && resource.data.role == 'client' && resource.data.verificationStatus == 'PENDING'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verificationStatus', 'isVerified', 'updatedAt'])
          && request.resource.data.verificationStatus in ['VERIFIED', 'REJECTED']
          && request.resource.data.isVerified == (request.resource.data.verificationStatus == 'VERIFIED')
          && request.resource.data.updatedAt == request.time
          && decision.status == request.resource.data.verificationStatus
          && decision.reviewedBy == request.auth.uid && decision.reviewedAt == request.time;
      }
      allow read: if signedIn();
      allow create: if owns(userId) && validRole() && validProfilePhoto()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.get('suspended', false) != true
        && request.resource.data.get('isVerified', false) != true
        && !request.resource.data.keys().hasAny(['referralCode']);
      allow update: if (isAdmin() && userId != request.auth.uid && resource.data.role != 'admin'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'suspended', 'suspensionReason', 'suspensionType', 'suspendedUntil',
          'warningCount', 'lastWarningReason', 'lastWarnedAt', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.get('warningCount', 0) is int
        && request.resource.data.get('warningCount', 0) >= resource.data.get('warningCount', 0)
        && request.resource.data.get('lastWarningReason', '') is string
        && request.resource.data.get('lastWarningReason', '').size() <= 500
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'suspended', 'suspensionReason', 'suspensionType', 'suspendedUntil'
          ]) || (
            request.resource.data.suspended is bool
            && request.resource.data.suspensionReason is string
            && request.resource.data.suspensionReason.size() <= 500
            && ((request.resource.data.suspended == false
                && request.resource.data.suspensionReason == ''
                && request.resource.data.suspensionType == 'none'
                && request.resource.data.suspendedUntil == null)
              || (request.resource.data.suspended == true
                && request.resource.data.suspensionReason.size() >= 5
                && request.resource.data.suspensionType in ['temporary', 'permanent']
                && ((request.resource.data.suspensionType == 'permanent'
                    && request.resource.data.suspendedUntil == null)
                  || (request.resource.data.suspensionType == 'temporary'
                    && request.resource.data.suspendedUntil is timestamp
                    && request.resource.data.suspendedUntil > request.time
                    && request.resource.data.suspendedUntil <= request.time + duration.value(365, 'd'))))))))
        || (owns(userId)
          && resource.data.get('suspended', false) == true
          && resource.data.get('suspensionType', '') == 'temporary'
          && resource.data.suspendedUntil is timestamp
          && resource.data.suspendedUntil <= request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'suspended', 'suspensionReason', 'suspensionType', 'suspendedUntil', 'updatedAt'
          ])
          && request.resource.data.suspended == false
          && request.resource.data.suspensionReason == ''
          && request.resource.data.suspensionType == 'none'
          && request.resource.data.suspendedUntil == null
          && request.resource.data.updatedAt == request.time)
        || (owns(userId) && active() && protectedUserFieldsUnchanged() && validReferralCodeUpdate(userId)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['photoURL']) || validProfilePhoto()));
      allow delete: if false;
      match /moderationHistory/{eventId} {
        allow read: if owns(userId) || isAdmin();
        allow create: if isAdmin()
          && request.resource.data.keys().hasOnly(['type', 'reason', 'actorId', 'suspendedUntil', 'createdAt'])
          && request.resource.data.type in ['warning', 'temporary_suspension', 'permanent_suspension', 'reinstated']
          && request.resource.data.reason is string
          && request.resource.data.reason.size() >= 5 && request.resource.data.reason.size() <= 500
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.createdAt == request.time
          && ((request.resource.data.type == 'temporary_suspension'
              && request.resource.data.suspendedUntil is timestamp)
            || (request.resource.data.type != 'temporary_suspension'
              && !request.resource.data.keys().hasAny(['suspendedUntil'])));
        allow update, delete: if false;
      }
      match /savedGigs/{gigId} {
        allow read: if owns(userId) && active();
        allow create: if owns(userId) && active() && currentUser().data.role == 'freelancer'
          && request.resource.data.keys().hasOnly(['gigId', 'savedAt'])
          && request.resource.data.gigId == gigId
          && request.resource.data.savedAt == request.time
          && exists(/databases/$(database)/documents/gigs/$(gigId));
        allow update: if false;
        allow delete: if owns(userId) && active();
      }
      match /notifications/{notificationId} {
        function validApplicationAnnouncement() {
          let data = request.resource.data;
          let application = get(/databases/$(database)/documents/applications/$(data.entityId)).data;
          let gig = get(/databases/$(database)/documents/gigs/$(application.gigId)).data;
          let name = application.get('youthName', '') != '' ? application.youthName : 'A youth user';
          return data.keys().hasOnly(['userId', 'type', 'title', 'body', 'read', 'route', 'entityId', 'createdAt'])
            && notificationId == 'application-' + data.entityId
            && data.userId == userId && application.businessId == userId
            && gig.postedBy.uid == userId && application.youthId != userId
            && data.type == 'application' && data.title == 'New gig application'
            && data.body == name + ' applied to your gig.'
            && data.route == '/(app)/gig/' + application.gigId
            && data.read == false && data.createdAt == request.time;
        }
        function validGigAnnouncement() {
          let data = request.resource.data;
          let gig = get(/databases/$(database)/documents/gigs/$(data.entityId)).data;
          return data.keys().hasOnly(['userId', 'type', 'title', 'body', 'read', 'route', 'entityId', 'createdAt'])
            && notificationId == 'gig-posted-' + data.entityId
            && data.userId == userId
            && data.type == 'gig_posted'
            && data.title == 'New gig posted'
            && data.body == gig.title
            && data.route == '/(app)/gig/' + data.entityId
            && data.read == false && data.createdAt == request.time
            && gig.status == 'open' && gig.postedBy.uid != userId;
        }
        allow read: if owns(userId);
        allow create: if active();
        allow delete: if owns(userId) || isAdmin();
        allow update: if owns(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      }
      match /reviews/{reviewId} {
        allow read: if signedIn();
        function validGigReview() {
          let data = request.resource.data;
          let gig = get(/databases/$(database)/documents/gigs/$(data.gigId)).data;
          let owner = gig.postedBy.uid;
          let worker = gig.assignedYouthId;
          return gig.status == 'completed' && gig.get('moderationRemoved', false) != true
            && owner != worker && request.auth.uid != userId
            && ((request.auth.uid == owner && userId == worker && currentUser().data.role == 'client')
              || (request.auth.uid == worker && userId == owner && currentUser().data.role in ['freelancer', 'youth']))
            && reviewId == data.gigId + '_' + request.auth.uid
            && data.keys().hasOnly(['gigId', 'reviewerId', 'reviewedUserId', 'reviewerRole', 'authorId', 'authorName', 'rating', 'comment', 'createdAt'])
            && data.authorId == request.auth.uid && data.authorName is string
            && data.reviewerId == request.auth.uid && data.reviewedUserId == userId
            && data.reviewerRole == currentUser().data.role
            && data.rating is int && data.rating >= 1 && data.rating <= 5
            && data.comment is string && data.comment.size() <= 1000
            && data.createdAt == request.time;
        }
        allow create: if active() && validGigReview();
        allow update, delete: if false;
      }
      match /endorsements/{endorsementId} {
        allow read: if signedIn();
        allow create: if active() && request.auth.uid != userId
          && request.resource.data.endorserId == request.auth.uid;
        allow update: if false;
        allow delete: if isAdmin() || (active() && resource.data.endorserId == request.auth.uid);
      }
      match /pushTokens/{tokenId} {
        allow read, create, update, delete: if owns(userId) && active();
      }
    }
    match /businessVerificationRequests/{businessId} {
      function validSubmission() {
        let data = request.resource.data;
        let business = get(/databases/$(database)/documents/users/$(businessId)).data;
        return owns(businessId) && active() && business.role == 'client'
          && data.keys().hasOnly(['businessId', 'status', 'businessName', 'fullName', 'email', 'phone', 'address', 'businessCategory', 'businessDetails', 'details', 'submittedAt'])
          && data.businessId == businessId && data.status == 'PENDING' && data.submittedAt == request.time
          && data.businessName == business.businessName && data.businessName is string && data.businessName.size() > 0
          && data.email == business.email && data.email is string && data.email.size() > 0
          && data.phone == business.phone && data.phone is string && data.phone.size() > 0
          && data.address == business.address && data.address is string && data.address.size() > 0
          && data.businessDetails == business.businessDetails && data.businessDetails is string && data.businessDetails.size() > 0
          && data.fullName == business.get('fullName', '') && data.businessCategory == business.get('businessCategory', '')
          && data.details is string && data.details.size() >= 5 && data.details.size() <= 2000
          && business.get('verificationStatus', '') in ['', 'REJECTED']
          && getAfter(/databases/$(database)/documents/users/$(businessId)).data.verificationStatus == 'PENDING';
      }
      allow read: if isAdmin() || (owns(businessId) && active());
      allow create: if validSubmission();
      allow update: if (resource.data.status == 'REJECTED' && validSubmission())
        || (isAdmin() && resource.data.status == 'PENDING'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'rejectionReason', 'reviewedBy', 'reviewedAt'])
          && request.resource.data.status in ['VERIFIED', 'REJECTED']
          && request.resource.data.reviewedBy == request.auth.uid && request.resource.data.reviewedAt == request.time
          && request.resource.data.rejectionReason is string && request.resource.data.rejectionReason.size() <= 500
          && (request.resource.data.status == 'VERIFIED' ? request.resource.data.rejectionReason == '' : request.resource.data.rejectionReason.size() >= 5)
          && getAfter(/databases/$(database)/documents/users/$(businessId)).data.verificationStatus == request.resource.data.status);
      allow delete: if false;
    }
    match /referralCodes/{code} {
      // Public lookup exposes only the code owner ID, never profile or contact data.
      allow get: if true;
      allow list: if false;
      allow create: if active() && code.matches('[A-Z0-9]{10}')
        && request.resource.data.keys().hasOnly(['ownerId', 'createdAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && !currentUser().data.keys().hasAny(['referralCode'])
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.referralCode == code;
      allow update, delete: if false;
    }
    match /referrals/{newUserId} {
      allow read: if signedIn() && (request.auth.uid == newUserId || resource.data.referrerId == request.auth.uid);
      allow create: if owns(newUserId)
        && !exists(/databases/$(database)/documents/users/$(newUserId))
        && existsAfter(/databases/$(database)/documents/users/$(newUserId))
        && request.resource.data.keys().hasOnly(['referrerId', 'referralCode', 'createdAt'])
        && request.resource.data.referrerId != newUserId
        && request.resource.data.referrerId == get(/databases/$(database)/documents/referralCodes/$(request.resource.data.referralCode)).data.ownerId
        && get(/databases/$(database)/documents/users/$(request.resource.data.referrerId)).data.get('suspended', false) != true
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /applications/{applicationId} {
      function participant() { return request.auth.uid == resource.data.youthId || request.auth.uid == resource.data.businessId; }
      allow get: if active() && (!exists(/databases/$(database)/documents/applications/$(applicationId)) || participant());
      allow list: if isAdmin() || (active() && participant());
      allow create: if active() && currentUser().data.role == 'freelancer'
        && request.resource.data.youthId == request.auth.uid
        && applicationId == 'app_' + request.resource.data.gigId + '_' + request.auth.uid
        && request.resource.data.applicationId == applicationId
        && request.resource.data.businessId == get(/databases/$(database)/documents/gigs/$(request.resource.data.gigId)).data.postedBy.uid
        && request.resource.data.businessId != request.auth.uid
        && get(/databases/$(database)/documents/gigs/$(request.resource.data.gigId)).data.status == 'open'
        && getAfter(/databases/$(database)/documents/gigs/$(request.resource.data.gigId)).data.status == 'open'
        && request.resource.data.status == 'pending'
        && request.resource.data.message is string && request.resource.data.message.size() >= 5 && request.resource.data.message.size() <= 500
        && request.resource.data.availabilityConfirmed == true
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if active() && request.auth.uid == resource.data.businessId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && ((resource.data.status == 'pending' && request.resource.data.status == 'rejected')
          || (resource.data.status == 'pending' && request.resource.data.status == 'accepted'
            && get(/databases/$(database)/documents/gigs/$(resource.data.gigId)).data.status == 'open'
            && getAfter(/databases/$(database)/documents/gigs/$(resource.data.gigId)).data.assignedYouthId == resource.data.youthId
            && getAfter(/databases/$(database)/documents/gigs/$(resource.data.gigId)).data.acceptedApplicationId == applicationId
            && getAfter(/databases/$(database)/documents/gigs/$(resource.data.gigId)).data.status in ['in-progress', 'filled'])
          || (resource.data.status == 'accepted' && request.resource.data.status == 'completed'
            && getAfter(/databases/$(database)/documents/gigs/$(resource.data.gigId)).data.status == 'completed'));
      allow delete: if false;
    }
    match /gigs/{gigId} {
      allow read: if signedIn();
      allow create: if active() && currentUser().data.role == 'client'
        && request.resource.data.postedBy.uid == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() >= 5
        && request.resource.data.description is string && request.resource.data.description.size() >= 20
        && request.resource.data.pay is number && request.resource.data.pay > 0
        && !request.resource.data.keys().hasAny(['moderationRemoved', 'moderationReason', 'moderatedBy', 'moderatedAt'])
        && request.resource.data.status == 'open';
      allow update: if (isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'moderationRemoved', 'moderationReason', 'moderatedBy', 'moderatedAt', 'updatedAt'])
        && request.resource.data.status == 'closed' && request.resource.data.moderationRemoved == true
        && request.resource.data.moderationReason is string
        && request.resource.data.moderationReason.size() >= 5 && request.resource.data.moderationReason.size() <= 500
        && request.resource.data.moderatedBy == request.auth.uid
        && request.resource.data.moderatedAt == request.time && request.resource.data.updatedAt == request.time)
        || (active() && resource.data.get('moderationRemoved', false) != true
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['moderationRemoved', 'moderationReason', 'moderatedBy', 'moderatedAt']) && (
        (resource.data.postedBy.uid == request.auth.uid
          && currentUser().data.role == 'client'
          && request.resource.data.postedBy == resource.data.postedBy
          && (request.resource.data.status != 'closed'
            || resource.data.status in ['open', 'closed']))
        || (resource.data.status == 'open'
          && request.resource.data.status == 'open'
          && getAfter(/databases/$(database)/documents/gigs/$(gigId)).data.status == 'open'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['applicantsCount']))));
      allow delete: if active() && resource.data.get('moderationRemoved', false) != true && resource.data.postedBy.uid == request.auth.uid;
    }
    match /chats/{chatId} {
      allow read, update, delete: if active() && request.auth.uid in resource.data.participants;
      allow create: if active() && request.auth.uid in request.resource.data.participants;
      match /messages/{messageId} {
        allow read: if active() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if active() && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow update, delete: if active() && resource.data.senderId == request.auth.uid;
      }
    }
    match /conversations/{conversationId} {
      function isParticipant() {
        return request.auth.uid == resource.data.youthId
          || request.auth.uid == resource.data.businessId
          || (resource.data.keys().hasAny(['participants']) && request.auth.uid in resource.data.participants);
      }
      function willBeParticipant() {
        return request.auth.uid == request.resource.data.youthId
          || request.auth.uid == request.resource.data.businessId
          || (request.resource.data.keys().hasAny(['participants']) && request.auth.uid in request.resource.data.participants);
      }

      allow read: if active() && isParticipant();
      allow create: if active() && willBeParticipant();
      allow update: if active() && (isParticipant() || willBeParticipant());
      allow delete: if isAdmin() || (active() && isParticipant());

      match /messages/{messageId} {
        function parentConv() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }
        function isConvParticipant() {
          return request.auth.uid == parentConv().youthId
            || request.auth.uid == parentConv().businessId
            || (parentConv().keys().hasAny(['participants']) && request.auth.uid in parentConv().participants);
        }

        allow read: if active() && isConvParticipant();
        allow create: if active() && request.resource.data.senderId == request.auth.uid && isConvParticipant();
        allow update: if active() && isConvParticipant()
          && (resource.data.senderId == request.auth.uid
              || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt', 'readBy']));
        allow delete: if active() && resource.data.senderId == request.auth.uid;
      }
    }
  }
}
